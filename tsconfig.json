{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["three"],
    "paths": {
      "@conduit/planet": ["./packages/conduit-planet/src/index.ts"],
      "@conduit/planet/*": ["./packages/conduit-planet/src/*"],
      "@conduit/web3d": ["./packages/conduit-web3d/src/index.ts"],
      "@conduit/web3d/*": ["./packages/conduit-web3d/src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
